# ── Service ───────────────────────────────────────────────────────────────────
PORT=4100
NODE_ENV=production
CORS_ORIGIN=*
HTTP_LOG=true

# Must be identical to the POS backend's JWT secret.
JWT_SECRET=replace-with-the-same-secret-as-the-pos-backend

# ── OLTP (source) database ────────────────────────────────────────────────────
DB_HOST=h40.eu.core.hostnext.net
DB_PORT=3306
DB_USER=petzonep_zubairahmed
DB_PASSWORD=kaimkhankhani@123
DB_NAME=petzonep_petzone-software-datawarehouse
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=50

# ── OLAP (warehouse) database ─────────────────────────────────────────────────
DW_ENABLED=true
DW_DB_HOST=localhost
DW_DB_PORT=3306
DW_DB_USER=root
DW_DB_PASSWORD=
DW_DB_NAME=petzone_dw
DW_DB_POOL_LIMIT=5
DW_DB_QUEUE_LIMIT=50

# ── Timezone ──────────────────────────────────────────────────────────────────
# Offset is used by SQL CONVERT_TZ during extraction.
REPORT_TIMEZONE=+05:00
# IANA name is used by JS date keys and the scheduler (DST-safe).
REPORT_TIMEZONE_NAME=Asia/Karachi

# ── ETL scheduling ────────────────────────────────────────────────────────────
DW_SCHEDULER_ENABLED=true
DW_DAILY_SYNC_TIME=12:00
DW_INCREMENTAL_MINUTES=15
DW_RECONCILE_DAYS=7
DW_SYNC_OVERLAP_MINUTES=10
DW_BATCH_SIZE=500
DW_STARTUP_DELAY_SECONDS=15
DW_AUTO_INIT=true

# ── Read path ─────────────────────────────────────────────────────────────────
DW_REPORT_CACHE_SECONDS=30
DW_REPORT_CACHE_MAX=200
